#!/usr/bin/env zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT_DIR/lib/utm-common.zsh"

vm_uuid="${VM_UUID:-${vm_uuid:-}}"
vm_name="${VM_NAME:-${vm_name:-}}"
vm_status="${VM_STATUS:-${vm_status:-}}"
vm_backend="${VM_BACKEND:-${vm_backend:-}}"
utm_focus_on_start="${UTM_FOCUS_ON_START:-${utm_focus_on_start:-1}}"

invalid_item_json() {
  print -r -- '{"items":[{"title":"No VM selected","subtitle":"Search for a virtual machine and select it","valid":false}]}'
}


action_item_json() {
  local title="$1"
  local subtitle="$2"
  local action="$3"
  local arg="$vm_uuid"
  local focus_value cmd_focus_value cmd_subtitle

  if [[ "$action" == "clone" ]]; then
    arg=""
  fi

  if is_start_action "$action"; then
    focus_value="$(start_focus_default_value "$utm_focus_on_start")"
  fi

  print -rn -- '{"title":'$(json_string "$title")',"subtitle":'$(json_string "$subtitle")',"arg":'$(json_string "$arg")','
  action_variables_json "$vm_uuid" "$vm_name" "$vm_status" "$vm_backend" "$action" "$focus_value"

  if is_start_action "$action"; then
    cmd_focus_value="$((1 - focus_value))"
    cmd_subtitle="Start ($(start_focus_subtitle "$cmd_focus_value"))"
    print -rn -- ',"mods":{"cmd":{"valid":true,"subtitle":'$(json_string "$cmd_subtitle")',"arg":'$(json_string "$arg")','
    action_variables_json "$vm_uuid" "$vm_name" "$vm_status" "$vm_backend" "$action" "$cmd_focus_value"
    print -rn -- '}}'
  fi

  print -rn -- '}'
}

append_action() {
  local title="$1"
  local subtitle="$2"
  local action="$3"

  items+=("$(action_item_json "$title" "$subtitle" "$action")")
}

if [[ -z "$vm_uuid" || -z "$vm_name" || -z "$vm_status" ]]; then
  invalid_item_json
  exit 0
fi

items=()

case "$vm_status" in
  (stopped|suspended|paused)
    append_action "Start $vm_name" "Start this virtual machine" "start"
    if [[ "$vm_backend" == "QEMU" ]]; then
      append_action "Run $vm_name Without Saving Changes" "Start disposable snapshot mode" "start-disposable"
    fi
    ;;
  (running|started)
    append_action "Stop $vm_name" "Shut down this virtual machine" "stop"
    append_action "Force Stop $vm_name" "Power off this virtual machine" "force-stop"
    append_action "Suspend $vm_name" "Suspend this virtual machine" "suspend"
    append_action "IP Address for $vm_name" "Show this virtual machine's IP address" "ip-address"
    ;;
esac

append_action "Clone $vm_name" "Clone this virtual machine" "clone"

print -r -- '{"items":['"${(j:,:)items}"']}'
