#!/usr/bin/env zsh
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT_DIR/lib/utm-common.zsh"
export UTM_DOCS_DIR UTM_ICON_DIR

mode="${1:-all}"
started_ms="$(utm_now_ms)"

if [[ -z "${UTMCTL_FIXTURE_LIST:-}" ]]; then
  if [[ ! -x "$UTMCTL_BIN" ]]; then
    exec /usr/bin/osascript -l JavaScript "$ROOT_DIR/lib/utm-filter.js" error \
      "utmctl not found" "Expected /Applications/UTM.app/Contents/MacOS/utmctl"
  fi
  if ! utm_command "$UTMCTL_BIN" list; then
    exec /usr/bin/osascript -l JavaScript "$ROOT_DIR/lib/utm-filter.js" error \
      "utmctl list failed" "$UTM_COMMAND_ERROR"
  fi
fi

signature=""
if [[ "${UTM_CACHE_DISABLE:-0}" != 1 ]]; then
  signature="$(utm_metadata_signature 2>/dev/null)" || signature=""
fi
print -rn -- "${UTM_COMMAND_OUTPUT:-}" | /usr/bin/osascript -l JavaScript \
  "$ROOT_DIR/lib/utm-filter.js" list "$mode" "$signature"
finished_ms="$(utm_now_ms)"
utm_debug_log "vm-list mode=$mode state=live elapsed_ms=$((finished_ms - started_ms))"
