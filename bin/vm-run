#!/usr/bin/env zsh
set -euo pipefail

: "${UTMCTL_BIN:=/Applications/UTM.app/Contents/MacOS/utmctl}"

is_start_action() {
  [[ "$1" == start || "$1" == start-disposable ]]
}

# Call directly (not in a subshell) to retain the output and error variables.
utm_command() {
  emulate -L zsh

  UTM_COMMAND_OUTPUT=""
  UTM_COMMAND_ERROR=""
  local stderr_file stderr_text
  local cmd_status=0

  if ! stderr_file="$(mktemp "${TMPDIR:-/tmp}/alfred-utm-command.XXXXXX")"; then
    UTM_COMMAND_ERROR="Could not capture UTM command diagnostics."
    return 1
  fi

  {
    if UTM_COMMAND_OUTPUT="$("$@" 2>"$stderr_file")"; then
      cmd_status=0
    else
      cmd_status=$?
    fi
    stderr_text="$(<"$stderr_file")"
    # Keep warnings in Alfred's debugger, never in list or IP-address data.
    /bin/cat "$stderr_file" >&2
  } always {
    /bin/rm -f "$stderr_file"
  }

  if (( cmd_status == 0 )) && [[ "$stderr_text" == 'Error from event:'* || "$stderr_text" == *$'\nError from event:'* ]]; then
    cmd_status=1
  fi
  if (( cmd_status != 0 )); then
    UTM_COMMAND_ERROR="${stderr_text:-${UTM_COMMAND_OUTPUT:-UTM command failed (exit status $cmd_status).}}"
  fi
  return "$cmd_status"
}

vm_uuid="${VM_UUID:-${vm_uuid:-}}"
vm_name="${VM_NAME:-${vm_name:-}}"
vm_action="${VM_ACTION:-${vm_action:-}}"
clone_name="${CLONE_NAME:-${clone_name:-}}"
utm_focus_after_start="${UTM_FOCUS_AFTER_START:-${utm_focus_after_start:-${UTM_FOCUS_ON_START:-1}}}"

if [[ -z "$vm_uuid" && -z "$vm_name" && -z "$vm_action" && $# -ge 3 ]]; then
  vm_uuid="$1"
  vm_name="$2"
  vm_action="$3"
  clone_name="${clone_name:-${4:-}}"
elif [[ -z "$vm_action" && $# -ge 1 ]]; then
  vm_action="$1"
fi

shell_command() {
  local -a command=("$@")
  print -r -- "${(j: :)${(@q)command}}"
}

should_focus_after_start() {
  [[ "$utm_focus_after_start" == 1 ]] || return 1
  is_start_action "$vm_action"
}

focus_utm() {
  "${UTM_FOCUS_BIN:-/usr/bin/open}" -a UTM >/dev/null 2>&1 || true
}

run_command() {
  local success_message="$1"
  shift

  local cmd_status
  local -a command=("$@")

  if [[ "${VM_DRY_RUN:-}" == 1 ]]; then
    shell_command "${command[@]}"
    return 0
  fi

  if utm_command "${command[@]}"; then
    :
  else
    cmd_status=$?
    print -r -- "Failed: $UTM_COMMAND_ERROR"
    return "$cmd_status"
  fi

  if should_focus_after_start; then
    focus_utm
  fi

  if [[ "$vm_action" == "ip-address" && -n "$UTM_COMMAND_OUTPUT" ]]; then
    print -r -- "IP addresses for $vm_name: $UTM_COMMAND_OUTPUT"
  else
    print -r -- "$success_message"
  fi
}

if [[ -z "$vm_uuid" || -z "$vm_name" || -z "$vm_action" ]]; then
  print -r -- "Missing VM action context"
  exit 1
fi

case "$vm_action" in
  (start)
    run_command "Started $vm_name" "$UTMCTL_BIN" start "$vm_uuid"
    ;;
  (start-disposable)
    run_command "Started $vm_name without saving changes" "$UTMCTL_BIN" start "$vm_uuid" --disposable
    ;;
  (stop)
    run_command "Requested shutdown for $vm_name" "$UTMCTL_BIN" stop "$vm_uuid" --request
    ;;
  (force-stop)
    run_command "Force stop sent to $vm_name" "$UTMCTL_BIN" stop "$vm_uuid" --force
    ;;
  (suspend)
    run_command "Suspended $vm_name" "$UTMCTL_BIN" suspend "$vm_uuid"
    ;;
  (ip-address)
    run_command "IP addresses for $vm_name:" "$UTMCTL_BIN" ip-address "$vm_uuid"
    ;;
  (clone)
    if [[ -z "$clone_name" ]]; then
      print -r -- "Missing VM action context"
      exit 1
    fi
    run_command "Clone created: $clone_name" "$UTMCTL_BIN" clone "$vm_uuid" --name "$clone_name"
    ;;
  (*)
    print -r -- "Unknown VM action: $vm_action"
    exit 1
    ;;
esac
